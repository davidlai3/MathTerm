{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mathterm",
  "version": "0.0.1",
  "identifier": "dev.mathterm",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "mathterm", "width": 900, "height": 600, "backgroundThrottling": "disabled" }],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png", "icons/icon.icns"],
    "resources": { "../bin/mdv": "bin/mdv" },
    "macOS": { "signingIdentity": "-" }
  }
}
