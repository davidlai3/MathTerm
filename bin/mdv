#!/usr/bin/env python3
"""mdv [file.md]: print markdown, rendering $..$ and $$..$$ via mathterm's OSC 7777.
Outside mathterm it prints the file unchanged. Reads stdin if no file given."""
import os, re, shutil, sys

DISPLAY = re.compile(r"\$\$(.+?)\$\$", re.S)
# pandoc's rule: no space just inside the $s, closing $ not followed by a digit (so "$5 and $10" is left alone)
INLINE = re.compile(r"(?<![\\$])\$(?=\S)([^$\n]+?)(?<=\S)\$(?!\$|\d)")
FENCE = re.compile(r"(```.*?```)", re.S)


def osc(tex, cols, rows):
    return f"\033]7777;{cols};{rows};{tex}\a"


def render(text, width):
    def display(m):
        tex = " ".join(m.group(1).split())  # OSC payload can't hold newlines
        rows = 3 + m.group(1).count(r"\\")  # ponytail: guessed size, terminal shrinks to fit; have the terminal measure if this looks off
        return "\n" + osc(tex, width, rows) + "\n" * rows

    def inline(m):
        cols = max(2, len(m.group(1)) * 6 // 10 + 1)  # ponytail: same guess
        return osc(m.group(1), cols, 1) + " " * cols

    parts = FENCE.split(text)
    for i in range(0, len(parts), 2):  # even parts are outside code fences
        parts[i] = INLINE.sub(inline, DISPLAY.sub(display, parts[i]))
    return "".join(parts)


def test():
    out = render("a $x^2$ b", 80)
    assert "\033]7777;" in out and ";1;x^2\a" in out, out
    assert render("costs $5 and $10", 80) == "costs $5 and $10"
    assert render("```\n$x$\n```", 80) == "```\n$x$\n```"
    out = render("$$\na \\\\ b\n$$", 80)
    assert ";80;4;a \\\\ b\a" in out, repr(out)
    print("ok")


if __name__ == "__main__":
    if sys.argv[1:] == ["--test"]:
        test()
        sys.exit()
    text = open(sys.argv[1]).read() if sys.argv[1:] else sys.stdin.read()
    if os.environ.get("MATHTERM") == "1":
        text = render(text, shutil.get_terminal_size().columns)
    sys.stdout.write(text)
