#!/usr/bin/env python3
"""mdv [file.md]: print markdown with ANSI styling. Inside mathterm, $..$ and $$..$$ are typeset via OSC 7777;
elsewhere the math is left as LaTeX source. When stdout isn't a tty the file is printed unchanged.
Reads stdin if no file is given."""
import os, re, select, shutil, sys, termios, tty

# $$display$$ | $inline$ (pandoc's rule: no space just inside the $s, closing $ not followed by a digit)
MATH = re.compile(r"\$\$(.+?)\$\$|(?<![\\$])\$(?=\S)([^$\n]+?)(?<=\S)\$(?!\$|\d)", re.S)
FENCE = re.compile(r"(^```.*?^```)", re.S | re.M)
CODE = re.compile(r"`([^`\n]+)`")
REPLY = re.compile(rb"\033\]7777;=;(\d+);(\d+)\a")

# Placeholders (private-use chars) keep math and code spans away from the styling regexes.
MATH_PH = re.compile("\ue000(\\d+)\ue001")
CODE_PH = re.compile("\ue002(\\d+)\ue003")

CODE_ON, FG_OFF = "\033[33m", "\033[39m"  # ANSI yellow, so the terminal theme picks the shade
DIM, DIM_OFF, BOLD, BOLD_OFF = "\033[2m", "\033[22m", "\033[1m", "\033[22m"
ANSI = re.compile(r"\033\[[0-9;]*m|\033\]8;;[^\033]*\033\\")  # SGR + OSC 8 links (zero-width)
LINK = re.compile(r"\[([^\]]+)\]\(([^)\s]+)\)")
INLINE_STYLES = [
    (re.compile(r"!\[([^\]]*)\]\([^)]*\)"), "\033[2m[image: \\1]\033[22m"),
    (re.compile(r"\*\*(?=\S)(.+?)(?<=\S)\*\*"), "\033[1m\\1\033[22m"),
    (re.compile(r"(?<![\w*])\*(?=\S)(.+?)(?<=\S)\*(?![\w*])"), "\033[3m\\1\033[23m"),
    (re.compile(r"(?<!\w)_(?=\S)(.+?)(?<=\S)_(?!\w)"), "\033[3m\\1\033[23m"),  # snake_case is safe
    (re.compile(r"~~(.+?)~~"), "\033[9m\\1\033[29m"),
]
TABLE_SEP = re.compile(r"\s*\|?\s*:?-+:?\s*(\|\s*:?-+:?\s*)*\|?\s*$")


def inline(text, in_mathterm):
    """Inline markdown. Links are OSC 8 hyperlinks; mathterm makes them clickable and shows the URL on hover,
    so the "(url)" suffix is only printed elsewhere."""
    for rx, rep in INLINE_STYLES[:1]:  # images first, so their [alt](src) isn't taken for a link
        text = rx.sub(rep, text)

    def link(m):
        label, url = m.group(1), m.group(2)
        out = f"\033]8;;{url}\033\\\033[4;34m{label}\033[24;39m\033]8;;\033\\"
        return out if in_mathterm else out + f" {DIM}({url}){DIM_OFF}"

    text = LINK.sub(link, text)
    for rx, rep in INLINE_STYLES[1:]:
        text = rx.sub(rep, text)
    return text


def style_line(line, width, in_mathterm):
    """Inside mathterm, rules are drawn by the terminal (OSC 7777;rule) so they track resizes."""
    def rule(kind, char, sgr):
        return f"\033]7777;rule;{kind}\a" if in_mathterm else f"\033[{sgr}m{char * width}\033[0m"

    if m := re.match(r"(#{1,6})\s+(.*)", line):
        if len(m.group(1)) == 1:
            return f"\033[1;35m{m.group(2)}\033[0m\n" + rule("h1", "═", "35")
        return f"\033[1;34m{m.group(2)}\033[0m"
    if re.fullmatch(r"\s*([-*_])(\s*\1){2,}\s*", line):
        return rule("hr", "─", "2")
    line = re.sub(r"^(\s*)[-*+]\s+", "\\1• ", line)
    line = re.sub(r"^>\s?", "\033[2m│\033[22m ", line)
    return inline(line, in_mathterm)


HASH_COMMENT_LANGS = {"python", "py", "sh", "bash", "zsh", "shell", "ruby", "rb", "yaml", "yml", "toml",
                      "r", "perl", "make", "makefile", "dockerfile", "elixir", "nim"}
KEYWORDS = ("def|class|return|if|elif|else|for|while|in|not|and|or|is|import|from|as|with|try|except|finally|"
            "raise|lambda|yield|pass|break|continue|fn|let|mut|pub|struct|enum|impl|trait|use|mod|match|const|"
            "static|var|function|async|await|catch|throw|new|this|self|super|true|false|True|False|None|null|"
            "nil|void|int|char|float|double|bool|auto|public|private|protected|interface|type|package|func|go|"
            "defer|switch|case|default|do|typedef|namespace|template|include|where|loop|echo|then|fi|done|esac")


def simple_highlight(code, lang):
    """Fallback when pygments isn't installed: comments, strings, numbers and common keywords."""
    comment = r"#[^\n]*" if lang in HASH_COMMENT_LANGS else r"//[^\n]*|/\*.*?\*/"
    tok = re.compile(rf"(?P<c>{comment})|(?P<s>\"(?:\\.|[^\"\\\n])*\"|'(?:\\.|[^'\\\n])*')"
                     rf"|(?P<n>\b\d+(?:\.\d+)?\b)|(?P<k>\b(?:{KEYWORDS})\b)", re.S)
    colors = {"c": "90", "s": "32", "n": "36", "k": "95"}
    return tok.sub(lambda m: f"\033[{colors[m.lastgroup]}m{m.group(0)}{FG_OFF}", code)


def highlight(code, lang):
    if not lang:
        return "\n".join(CODE_ON + l + FG_OFF for l in code.split("\n"))
    try:  # pygments is optional: much better lexers when it's installed
        from pygments import highlight as pyg
        from pygments.formatters import Terminal256Formatter
        from pygments.lexers import get_lexer_by_name
        return pyg(code, get_lexer_by_name(lang), Terminal256Formatter(style="monokai")).rstrip("\n")
    except Exception:  # not installed, or unknown language
        return simple_highlight(code, lang)


def raw(n, in_mathterm):
    """OSC 7777;raw: the next n cells are literal, so mathterm's auto-detect won't typeset `$x$` in code."""
    return f"\033]7777;raw;{n}\a" if in_mathterm and n else ""


def code_block(block, in_mathterm):
    first, *lines = block.split("\n")
    lang, lines = first[3:].strip().lower(), lines[:-1]  # drop the fences
    shown = highlight("\n".join(lines), lang).split("\n")
    return "\n".join(f"  {raw(len(src), in_mathterm)}{hl}" for src, hl in zip(lines, shown))


def cells(row):
    row = row.strip()
    row = row[1:] if row.startswith("|") else row
    row = row[:-1] if row.endswith("|") else row
    return [c.strip() for c in row.split("|")]  # ponytail: escaped \| isn't supported


def guess_sizes(maths):
    # ponytail: fallback when the terminal doesn't answer the size query
    return [(len(t) // 2 + 2, 3 + t.count(r"\\")) if d else (max(2, len(t) * 6 // 10 + 1), 1) for t, d in maths]


def query_sizes(maths):
    """Ask the terminal how many cells each expression needs (OSC 7777;?)."""
    try:
        fd = os.open("/dev/tty", os.O_RDWR)
    except OSError:
        return guess_sizes(maths)
    old = termios.tcgetattr(fd)
    buf = b""
    try:
        tty.setraw(fd)  # so the replies aren't echoed or line-buffered
        os.write(fd, "".join(f"\033]7777;?;{'d' if d else 'i'};{t}\a" for t, d in maths).encode())
        while len(REPLY.findall(buf)) < len(maths):
            if not select.select([fd], [], [], 1.0)[0]:
                break
            buf += os.read(fd, 4096)
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)
        os.close(fd)
    sizes = [(int(c), int(r)) for c, r in REPLY.findall(buf)]
    return sizes if len(sizes) == len(maths) else guess_sizes(maths)


def osc(tex, cols, rows, disp):
    return f"\033]7777;{cols};{rows};{'d' if disp else 'i'};{tex}\a"


def render(text, width, sizer=None):
    """Style markdown. With a sizer (inside mathterm), math becomes OSC 7777; without one, it stays as source."""
    in_mt = sizer is not None
    maths, codes = [], []  # (tex, is_display, source) / code span text

    def stash_math(m):
        disp = m.group(1) is not None
        tex = " ".join((m.group(1) if disp else m.group(2)).split())  # OSC can't hold newlines
        maths.append((tex, disp, m.group(0)))
        return f"\ue000{len(maths) - 1}\ue001"

    def stash_code(m):
        codes.append(m.group(1))
        return f"\ue002{len(codes) - 1}\ue003"

    # Swap math and code spans for placeholders first, then size the math: tables need its width.
    parts = FENCE.split(text)
    for i in range(0, len(parts), 2):  # even parts are outside code fences
        parts[i] = MATH.sub(stash_math, CODE.sub(stash_code, parts[i]))
    sizes = sizer([(t, d) for t, d, _ in maths]) if sizer and maths else None

    def tall(line):  # tall inline math (rows > 1) needs a blank row above and below
        return bool(sizes) and any(not maths[int(n)][1] and sizes[int(n)][1] > 1 for n in MATH_PH.findall(line))

    def vis_len(t):
        t = CODE_PH.sub(lambda m: "x" * len(codes[int(m.group(1))]), t)
        t = MATH_PH.sub(lambda m: "x" * (sizes[int(m.group(1))][0] if sizes else len(maths[int(m.group(1))][2])), t)
        return len(ANSI.sub("", t))

    def table(rows):
        seps = cells(rows[1])
        aligns = ["c" if c.startswith(":") and c.endswith(":") else "r" if c.endswith(":") else "l" for c in seps]
        n = len(aligns)
        body = [[inline(c, in_mt) for c in (cells(r) + [""] * n)[:n]] for r in [rows[0]] + rows[2:]]
        w = [max(vis_len(r[c]) for r in body) for c in range(n)]

        def pad(t, c):
            gap = w[c] - vis_len(t)
            left = {"l": 0, "c": gap // 2, "r": gap}[aligns[c]]
            return " " * left + t + " " * (gap - left)

        def border(l, mid, r):
            return DIM + l + mid.join("─" * (x + 2) for x in w) + r + DIM_OFF

        def row(r, header=False):
            bar = f"{DIM}│{DIM_OFF}"
            return bar + bar.join(f" {BOLD if header else ''}{pad(t, c)}{BOLD_OFF if header else ''} "
                                  for c, t in enumerate(r)) + bar

        out = [border("┌", "┬", "┐")]
        for i, r in enumerate(body):
            spacer = [row([""] * n)] if tall("".join(r)) else []
            out += spacer + [row(r, header=i == 0)] + spacer
            if i == 0:
                out.append(border("├", "┼", "┤"))
        return out + [border("└", "┴", "┘")]

    out = []
    for i, part in enumerate(parts):
        if i % 2:
            out.append(code_block(part, in_mt))
            continue
        lines, res, j = part.split("\n"), [], 0
        while j < len(lines):
            if "|" in lines[j] and j + 1 < len(lines) and TABLE_SEP.match(lines[j + 1]):
                k = j + 2
                while k < len(lines) and "|" in lines[k]:
                    k += 1
                res += table(lines[j:k])
                j = k
                continue
            styled = style_line(lines[j], width, in_mt)
            res += ["", styled, ""] if tall(lines[j]) else [styled]
            j += 1
        out.append("\n".join(res))
    s = CODE_PH.sub(lambda m: raw(len(codes[int(m.group(1))]), in_mt) + CODE_ON + codes[int(m.group(1))] + FG_OFF,
                    "".join(out))

    def emit(m):
        n = int(m.group(1))
        tex, disp, source = maths[n]
        if sizes is None:
            return source
        cols, rows = sizes[n]
        if disp:
            cols = min(cols, width)
            # reuse the source's own line breaks around $$..$$ instead of adding blank lines
            lead = "" if m.start() == 0 or s[m.start() - 1] == "\n" else "\n"
            tail = rows - 1 if s[m.end():m.end() + 1] == "\n" else rows
            return lead + osc(tex, cols, rows, True) + "\n" * tail  # the terminal centers it
        return osc(tex, cols, rows, False) + " " * cols  # spaces reserve the cells the overlay covers

    return MATH_PH.sub(emit, s)


def test():
    fixed = lambda maths: [(10, 2) if d else (4, 1) for _, d in maths]
    # math
    assert render("a $x^2$ b", 80, fixed) == "a \033]7777;4;1;i;x^2\a     b"
    assert render("costs $5 and $10", 80, fixed) == "costs $5 and $10"
    assert render("$$\na \\\\ b\n$$", 20, fixed) == "\033]7777;10;2;d;a \\\\ b\a\n\n"
    assert render("x\n$$y$$\nz", 20, fixed) == "x\n\033]7777;10;2;d;y\a\n\nz"
    assert render("x $$y$$ z", 20, fixed) == "x \n\033]7777;10;2;d;y\a\n\n z"
    tall = lambda maths: [(4, 3) for _ in maths]
    assert render("a\n$\\frac12$ b\nc", 80, tall) == "a\n\n\033]7777;4;3;i;\\frac12\a     b\n\nc"
    assert render("a $x^2$ b", 80) == "a $x^2$ b"  # no sizer: math left as source
    assert guess_sizes([("a \\\\ b", True)]) == [(5, 4)]
    # code is never math or styled
    assert render("```\n$x$ **y**\n```", 80) == f"  {CODE_ON}$x$ **y**{FG_OFF}"
    assert render("`$x$`", 80) == f"{CODE_ON}$x${FG_OFF}"
    # inside mathterm, code is marked literal so auto-detect leaves it alone
    assert render("```\n$x$ **y**\n```", 80, fixed) == f"  \033]7777;raw;9\a{CODE_ON}$x$ **y**{FG_OFF}"
    assert render("`$x$`", 80, fixed) == f"\033]7777;raw;3\a{CODE_ON}$x${FG_OFF}"
    # styling
    assert render("## Hi", 80) == "\033[1;34mHi\033[0m"
    assert render("**b** and *i*", 80) == "\033[1mb\033[22m and \033[3mi\033[23m"
    assert render("my_var_name", 80) == "my_var_name"
    assert render("- item\n  * sub", 80) == "• item\n  • sub"
    assert render("---", 3) == "\033[2m───\033[0m"
    assert render("---", 3, fixed) == "\033]7777;rule;hr\a"
    assert render("# T", 3, fixed) == "\033[1;35mT\033[0m\n\033]7777;rule;h1\a"
    link = "\033]8;;http://x\033\\\033[4;34mt\033[24;39m\033]8;;\033\\"
    assert render("[t](http://x)", 80) == link + " \033[2m(http://x)\033[22m"
    assert render("[t](http://x)", 80, fixed) == link  # mathterm: clickable, URL shown on hover
    assert render("![a](i.png)", 80) == "\033[2m[image: a]\033[22m"
    # tables (compare with styling stripped)
    plain = lambda t: re.sub(r"\033\][^\a]*\a", "", ANSI.sub("", t))
    assert plain(render("|a|b|\n|-|-:|\n|1|22|", 80)) == "┌───┬────┐\n│ a │  b │\n├───┼────┤\n│ 1 │ 22 │\n└───┴────┘"
    assert plain(render("| $x$ |\n|---|\n| y |", 80, fixed)) == "┌──────┐\n│      │\n├──────┤\n│ y    │\n└──────┘"
    assert plain(render("|`a|b`|\n|:-:|\n|c|", 80)) == "┌─────┐\n│ a|b │\n├─────┤\n│  c  │\n└─────┘"
    assert render("a | b", 80) == "a | b"  # a pipe alone isn't a table
    # code highlighting fallback
    assert simple_highlight("x = 1  # hi", "python") == "x = \033[36m1\033[39m  \033[90m# hi\033[39m"
    assert simple_highlight('let s = "a//b"; // c', "rust") == \
        '\033[95mlet\033[39m s = \033[32m"a//b"\033[39m; \033[90m// c\033[39m'
    assert render("**bold $x$**", 80, fixed) == "\033[1mbold \033]7777;4;1;i;x\a    \033[22m"
    print("ok")


if __name__ == "__main__":
    if sys.argv[1:] == ["--test"]:
        test()
        sys.exit()
    text = open(sys.argv[1]).read() if sys.argv[1:] else sys.stdin.read()
    if sys.stdout.isatty():
        sizer = query_sizes if os.environ.get("MATHTERM") == "1" else None
        text = render(text, shutil.get_terminal_size().columns, sizer)
    sys.stdout.write(text)
